{
  "name": "taskify",
  "version": "0.1.0",
  "private": true,
  "description": "Creates Tasks-plugin tasks from a configurable note property.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "obsidian-tasks"
  ],
  "author": "Chris Zappa",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
