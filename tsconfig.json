{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2018",
    "types": ["node"],
    "useUnknownInCatchVariables": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
